{
  "expo": {
    "name": "SCWA",
    "slug": "SCWA-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logodua.png",
    "scheme": "scwaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-menu.png",
        "backgroundColor": "#000000"
      },
      "package": "com.bangdhi.SCWAApp",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logodua.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#CDE4F5"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-notif.png", 
          "color": "#004e92",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e1ad895-d2ff-4add-bdb6-3f29708a7fcb"
      }
    }
  }
}